{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RB Code Companion",
  "version": "1.0.0",
  "identifier": "com.rbcode.companion",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "RB Code 本机执行器",
        "width": 540,
        "height": 700,
        "minWidth": 420,
        "minHeight": 520,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Rainbow",
    "copyright": "© 2026 Rainbow",
    "shortDescription": "RB Code 本机执行器",
    "longDescription": "RB Code 本机执行器：在网页里跟模型对话，让它读写文件、跑命令、操作屏幕。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"]
      }
    }
  }
}
